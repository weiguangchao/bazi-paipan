{
  "name": "bazi-paipan",
  "version": "0.1.0",
  "description": "八字排盘 CLI - 输入出生年月日时，算出四柱八字与大运",
  "type": "module",
  "bin": {
    "bazi": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run check:ascii-identifiers",
    "test:watch": "vitest",
    "check:ascii-identifiers": "node scripts/check-ascii-identifiers.mjs",
    "scrape:wenzhen": "tsx scripts/scrape-wenzhen.ts",
    "build:cities": "node scripts/build-public-data.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "playwright": "^1.61.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
